@inject ILogger<Forbidden> Logger
@inject NavigationManager Navigation
<PageTitle>Not allowed · Memorial Event Operations</PageTitle>
<div class="card" data-testid="forbidden">
    <h1 tabindex="-1">You cannot open this page</h1>
    <p>Your role does not include access to <code>@Path</code>. If you think you need it, ask a System Admin to review your roles.</p>
    <p><a class="btn btn--primary" href="/dashboard">Back to your dashboard</a></p>
</div>

@code {
    private string Path => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];

    protected override void OnInitialized() =>
        Logger.LogWarning("Denied page {Path} (insufficient role)", Path);
}
