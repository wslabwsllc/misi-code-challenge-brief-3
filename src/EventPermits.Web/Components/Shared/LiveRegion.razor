@* Polite announcement of the last successful action, plus a visible confirmation. *@
<div class="sr-live" role="status" aria-live="polite" aria-atomic="true">@Message</div>
@if (!string.IsNullOrEmpty(Message) && Visible)
{
    <div class="alert alert--success" aria-hidden="true" data-testid="success">
        <p class="alert__title"><span class="alert__icon">✓</span> @Message</p>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool Visible { get; set; } = true;
}
