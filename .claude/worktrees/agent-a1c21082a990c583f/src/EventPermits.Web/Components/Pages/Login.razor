@page "/account/login"
@layout PublicLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using EventPermits.Web.Api
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignIn
@inject UserManager<AppUser> Users
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Sign in · Memorial Event Operations</PageTitle>

<div class="landing">
    <div class="card card--narrow">
        <h1 tabindex="-1">Sign in</h1>
        <p class="muted">Use your staff account. Demo accounts for local runs are listed in the repository README.</p>

        @if (_error is not null)
        {
            <div class="alert alert--error" role="alert" id="login-error" data-testid="login-error">
                <p class="alert__title"><span class="alert__icon" aria-hidden="true">×</span><strong>Sign-in failed.</strong></p>
                <p>@_error</p>
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login" class="form" novalidate>
            <DataAnnotationsValidator />
            <div class="field">
                <label for="username">User name</label>
                <InputText id="username" @bind-Value="Input.UserName" autocomplete="username" aria-describedby="username-error"
                           aria-invalid="@(_error is not null ? "true" : null)" data-testid="login-username" />
                <ValidationMessage For="() => Input.UserName" id="username-error" class="field__error" />
            </div>
            <div class="field">
                <label for="password">Password</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" aria-describedby="password-error"
                           aria-invalid="@(_error is not null ? "true" : null)" data-testid="login-password" />
                <ValidationMessage For="() => Input.Password" id="password-error" class="field__error" />
            </div>
            <button type="submit" class="btn btn--primary" data-testid="login-submit">Sign in</button>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? _error;

    protected override void OnInitialized() => Input ??= new();

    private async Task SignInAsync()
    {
        var userName = Input.UserName.Trim();
        var user = await Users.FindByNameAsync(userName);
        if (user is not null && !user.IsActive)
        {
            Logger.LogWarning("Sign-in {Result} for {UserName}", "Inactive", userName);
            _error = "This account is not active. Ask a System Admin.";
            return;
        }
        var result = await SignIn.PasswordSignInAsync(userName, Input.Password, isPersistent: false, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            Logger.LogInformation("Sign-in {Result} for {UserName}", "Succeeded", userName);
            Navigation.NavigateTo(AccountEndpoints.SafeReturnUrl(ReturnUrl), forceLoad: true);
            return;
        }
        Logger.LogWarning("Sign-in {Result} for {UserName}", result.IsLockedOut ? "LockedOut" : "Failed", userName);
        _error = result.IsLockedOut
            ? "The account is locked for 15 minutes after five failed attempts."
            : "The user name or password is incorrect.";
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter your user name.")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
}
