    private static ResourceForm ResourceFormFor(ResourceRow r) => new()
    {
        Id = r.Id, Version = r.Version, CemeteryId = r.CemeteryId, Code = r.Code, Name = r.Name, Unit = r.Unit, Total = r.TotalQuantity, Active = r.IsActive,
    };

    private async Task SaveResourceAsync()
    {
        var f = _resourceForm!;
        _conflictRows = null;
        var errors = new Dictionary<string, string[]>();
        if (f.CemeteryId is null) errors["cemeteryId"] = ["Choose a cemetery."];
        if (string.IsNullOrWhiteSpace(f.Code)) errors["code"] = ["Code is required."];
        if (string.IsNullOrWhiteSpace(f.Name)) errors["name"] = ["Name is required."];
        if (string.IsNullOrWhiteSpace(f.Unit)) errors["unit"] = ["Unit is required."];
        if (f.Total is null) errors["totalQuantity"] = ["Enter the total quantity."];
        else if (f.Total < 0) errors["totalQuantity"] = ["Quantity cannot be negative."];
        if (errors.Count > 0)
        {
            Fail(errors);
            return;
        }
        await SendResourceAsync(f);
    }

    private async Task SendResourceAsync(ResourceForm f)
    {
        var ok = await RunAsync(me => Admin.SaveResourceAsync(me, f.Id, f.Version, f.CemeteryId!.Value, f.Code, f.Name, f.Unit, f.Total!.Value, f.Active), $"{f.Name?.Trim()} saved.");
        if (ok)
        {
            _resourceForm = null;
            await RefreshAsync(await GetActorAsync());
        }
        else if (Problem?.StatusCode == 409 && f.Id is { } id)
        {
            await ConflictAsync(() =>
            {
                var saved = _resources.First(r => r.Id == id);
                return Task.FromResult<IReadOnlyList<ConflictPanel.Row>>(
                [
                    new("Name", saved.Name, f.Name), new("Unit", saved.Unit, f.Unit),
                    new("Total", saved.TotalQuantity.ToString(Ui.Culture), f.Total?.ToString(Ui.Culture)), new("Active", saved.IsActive ? "Yes" : "No", f.Active ? "Yes" : "No"),
                ]);
            },
            reload: () => { _resourceForm = ResourceFormFor(_resources.First(r => r.Id == id)); return Task.CompletedTask; },
            reapply: () => { f.Version = _resources.First(r => r.Id == id).Version; return SendResourceAsync(f); });
        }
    }

    // ------------------------------------------------------------------ categories

    private static string DocName(DocumentType d) => d switch
    {
        DocumentType.ProofOfAffiliation => "Proof of affiliation",
        DocumentType.EventPlan => "Event plan",
        DocumentType.InsuranceCertificate => "Insurance certificate",
        DocumentType.SitePlan => "Site plan",
        _ => "Other document",
    };

    private void ToggleDoc(DocumentType d, ChangeEventArgs e)
    {
        if (e.Value is true) _categoryForm!.Documents.Add(d);
        else _categoryForm!.Documents.Remove(d);
    }

    private void NewCategory()
    {
        CancelForms();
        _categoryForm = new CategoryForm();
    }

    private void EditCategory(CategoryRow c)
    {
        CancelForms();
        _categoryForm = CategoryFormFor(c);
    }

    private static CategoryForm CategoryFormFor(CategoryRow c) => new()
    {
        Id = c.Id, Version = c.Version, Code = c.Code, Name = c.Name, Description = c.Description, Documents = [.. c.RequiredDocuments],
        Checklist = string.Join('\n', c.ReviewChecklist), Active = c.IsActive,
    };

    private async Task SaveCategoryAsync()
    {
        var f = _categoryForm!;
        _conflictRows = null;
        var errors = new Dictionary<string, string[]>();
        if (string.IsNullOrWhiteSpace(f.Code)) errors["code"] = ["Code is required."];
        if (string.IsNullOrWhiteSpace(f.Name)) errors["name"] = ["Name is required."];
        if (ChecklistItems(f).Count == 0) errors["checklist"] = ["Give at least one review checklist item."];
        if (errors.Count > 0)
        {
            Fail(errors);
            return;
        }
        await SendCategoryAsync(f);
    }

    private static List<string> ChecklistItems(CategoryForm f) =>
        (f.Checklist ?? "").Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();

    private async Task SendCategoryAsync(CategoryForm f)
    {
        var ok = await RunAsync(me => Admin.SaveCategoryAsync(me, f.Id, f.Version, f.Code, f.Name, f.Description, f.Documents.ToList(), ChecklistItems(f), f.Active),
            $"Category {f.Code?.Trim().ToUpperInvariant()} saved.");
        if (ok)
        {
            _categoryForm = null;
            await RefreshAsync(await GetActorAsync());
        }
        else if (Problem?.StatusCode == 409 && f.Id is { } id)
        {
            await ConflictAsync(() =>
            {
                var saved = _categories.First(c => c.Id == id);
                return Task.FromResult<IReadOnlyList<ConflictPanel.Row>>(
                [
                    new("Name", saved.Name, f.Name), new("Description", saved.Description, f.Description),
                    new("Required documents", string.Join(", ", saved.RequiredDocuments.Select(DocName)), string.Join(", ", f.Documents.Select(DocName))),
                    new("Checklist", string.Join("; ", saved.ReviewChecklist), string.Join("; ", ChecklistItems(f))),
                    new("Active", saved.IsActive ? "Yes" : "No", f.Active ? "Yes" : "No"),
                ]);
            },
            reload: () => { _categoryForm = CategoryFormFor(_categories.First(c => c.Id == id)); return Task.CompletedTask; },
            reapply: () => { f.Version = _categories.First(c => c.Id == id).Version; return SendCategoryAsync(f); });
        }
    }

    // ------------------------------------------------------------------ 409 handling

    private async Task ConflictAsync(Func<Task<IReadOnlyList<ConflictPanel.Row>>> rows, Func<Task> reload, Func<Task> reapply)
    {
        var problem = Problem;
        await RefreshAsync(await GetActorAsync());
        Problem = problem;
        _conflictRows = await rows();
        _reload = reload;
        _reapply = reapply;
    }

    private async Task ReloadAfterConflictAsync()
    {
        _conflictRows = null;
        Problem = null;
        await RefreshAsync(await GetActorAsync());
        if (_reload is not null) await _reload();
        Announcement = "Reloaded the saved version.";
    }

    private async Task ReapplyAsync()
    {
        _conflictRows = null;
        if (_reapply is not null) await _reapply();
    }

    // ------------------------------------------------------------------ formatting

    private static string HoursSummary(IReadOnlyList<OpeningHours> hours)
    {
        if (hours.Count == 0) return "Closed every day";
        return string.Join("; ", hours.OrderBy(h => ((int)h.Day + 6) % 7)
            .GroupBy(h => (h.Opens, h.Closes))
            .Select(g => $"{string.Join(", ", g.Select(h => h.Day.ToString()[..3]))} {g.Key.Opens.ToString("HH:mm", Ui.Culture)}–{g.Key.Closes.ToString("HH:mm", Ui.Culture)}"));
    }

    private static string Coordinates(VenueRow v) => v.Latitude is { } lat && v.Longitude is { } lon
        ? $"{lat.ToString("0.0000", Ui.Culture)}, {lon.ToString("0.0000", Ui.Culture)} ({(v.CoordinatesVerified ? "verified" : "unverified")})"
        : "Not geocoded (unverified)";
}
