    private IReadOnlyList<CemeteryRow> _cemeteries = [];
    private IReadOnlyList<VenueRow> _venues = [];
    private IReadOnlyList<BlackoutRow> _blackouts = [];
    private IReadOnlyList<ResourceRow> _resources = [];
    private IReadOnlyList<CategoryRow> _categories = [];
    private string _tab = "venues";
    private VenueForm? _venueForm;
    private ResourceForm? _resourceForm;
    private CategoryForm? _categoryForm;
    private ClosureForm _closure = new();
    private BlackoutRow? _lastClosure;
    private Guid? _closureFilter;
    private IReadOnlyList<ConflictPanel.Row>? _conflictRows;
    private Func<Task>? _reapply;
    private Func<Task>? _reload;

    private bool CanManage => Me?.Can(Cap.ManageVenues) == true;

    protected override async Task OnParametersSetAsync()
    {
        _tab = Tabs.Any(t => t.Item1 == TabQuery) ? TabQuery! : "venues";
        _conflictRows = null;
        if (_venues.Count == 0 && _cemeteries.Count == 0) await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        Problem = null;
        await LoadAsync(RefreshAsync);
    }

    private async Task RefreshAsync(Actor me)
    {
        _cemeteries = await Admin.CemeteriesAsync(me);
        _venues = await Admin.VenuesAsync(me);
        _blackouts = await Admin.BlackoutsAsync(me, null);
        _resources = await Admin.ResourcesAsync(me);
        _categories = await Admin.CategoriesAsync(me);
    }

    private string TabHref(string key) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["tab"] = key == "venues" ? null : key });

    private void CancelForms()
    {
        _venueForm = null;
        _resourceForm = null;
        _categoryForm = null;
        _conflictRows = null;
        Problem = null;
    }

    private static void Toggle(HashSet<string> set, string value, ChangeEventArgs e)
    {
        if (e.Value is true) set.Add(value);
        else set.Remove(value);
    }

    // ------------------------------------------------------------------ venues

    private void NewVenue()
    {
        CancelForms();
        _venueForm = new VenueForm
        {
            CemeteryId = _cemeteries.FirstOrDefault()?.Id,
            Hours = Week.Select(d => new DayForm { Day = d, Open = d is not (DayOfWeek.Saturday or DayOfWeek.Sunday) }).ToList(),
        };
    }

    private void EditVenue(VenueRow v)
    {
        CancelForms();
        _venueForm = FormFor(v);
    }

    private static VenueForm FormFor(VenueRow v) => new()
    {
        Id = v.Id, Version = v.Version, CemeteryId = v.CemeteryId, Code = v.Code, Name = v.Name, Address = v.Address, Capacity = v.Capacity,
        Setup = v.SetupBufferMinutes, Teardown = v.TeardownBufferMinutes, Active = v.IsActive,
        Hours = Week.Select(d => v.OpeningHours.FirstOrDefault(h => h.Day == d) is { } h
            ? new DayForm { Day = d, Open = true, Opens = h.Opens, Closes = h.Closes }
            : new DayForm { Day = d, Open = false }).ToList(),
        Categories = [.. v.AllowedCategoryCodes],
    };

    private async Task SaveVenueAsync()
    {
        var f = _venueForm!;
        _conflictRows = null;
        var errors = new Dictionary<string, string[]>();
        if (f.CemeteryId is null) errors["cemeteryId"] = ["Choose a cemetery."];
        if (string.IsNullOrWhiteSpace(f.Code)) errors["code"] = ["Code is required."];
        if (string.IsNullOrWhiteSpace(f.Name)) errors["name"] = ["Name is required."];
        if (string.IsNullOrWhiteSpace(f.Address)) errors["address"] = ["Address is required."];
        if (f.Capacity is null) errors["capacity"] = ["Enter the capacity."];
        if (f.Setup is null) errors["setupBufferMinutes"] = ["Enter the setup buffer (0 for none)."];
        if (f.Teardown is null) errors["teardownBufferMinutes"] = ["Enter the teardown buffer (0 for none)."];
        if (f.Hours.Any(h => h.Open && (h.Opens is null || h.Closes is null))) errors["openingHours"] = ["Give opening and closing times for every open day."];
        if (errors.Count > 0)
        {
            Fail(errors);
            return;
        }
        var input = new VenueInput(f.CemeteryId!.Value, f.Code, f.Name, f.Address, f.Capacity!.Value, f.Setup!.Value, f.Teardown!.Value,
            f.Hours.Where(h => h.Open).Select(h => new OpeningHours { Day = h.Day, Opens = h.Opens!.Value, Closes = h.Closes!.Value }).ToList(), f.Categories.ToList(), f.Active);
        await SendVenueAsync(f, input, $"Venue {f.Code?.Trim()} saved.");
    }

    private async Task SendVenueAsync(VenueForm f, VenueInput input, string success)
    {
        var ok = await RunAsync(me => Admin.SaveVenueAsync(me, f.Id, f.Version, input), success);
        if (ok)
        {
            _venueForm = null;
            await RefreshAsync(await GetActorAsync());
        }
        else if (Problem?.StatusCode == 409 && f.Id is { } id)
        {
            await ConflictAsync(async () =>
            {
                var saved = _venues.First(v => v.Id == id);
                return
                [
                    new("Name", saved.Name, input.Name), new("Address", saved.Address, input.Address),
                    new("Capacity", saved.Capacity.ToString(Ui.Culture), input.Capacity.ToString(Ui.Culture)),
                    new("Buffers", $"{saved.SetupBufferMinutes}/{saved.TeardownBufferMinutes}", $"{input.SetupBufferMinutes}/{input.TeardownBufferMinutes}"),
                    new("Opening hours", HoursSummary(saved.OpeningHours), HoursSummary(input.OpeningHours)),
                    new("Active", saved.IsActive ? "Yes" : "No", input.IsActive ? "Yes" : "No"),
                ];
            },
            reload: () => { _venueForm = _venues.FirstOrDefault(v => v.Id == id) is { } s ? FormFor(s) : null; return Task.CompletedTask; },
            reapply: () => { f.Version = _venues.First(v => v.Id == id).Version; return SendVenueAsync(f, input, success); });
        }
    }

    private async Task ToggleVenueAsync(VenueRow v)
    {
        CancelForms();
        var input = new VenueInput(v.CemeteryId, v.Code, v.Name, v.Address, v.Capacity, v.SetupBufferMinutes, v.TeardownBufferMinutes, v.OpeningHours, v.AllowedCategoryCodes, !v.IsActive);
        await SendVenueAsync(new VenueForm { Id = v.Id, Version = v.Version, Code = v.Code }, input, $"Venue {v.Code} {(v.IsActive ? "deactivated; it can no longer be booked" : "reactivated")}.");
    }

    // ------------------------------------------------------------------ closures

    private void ClosureFilterChanged(ChangeEventArgs e) => _closureFilter = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;

    private async Task AddClosureAsync()
    {
        _conflictRows = null;
        _lastClosure = null;
        var c = _closure;
        var errors = new Dictionary<string, string[]>();
        var venue = _venues.FirstOrDefault(v => v.Id == c.VenueId);
        if (venue is null) errors["venueId"] = ["Choose a venue."];
        if (c.Start is null) errors["startUtc"] = ["Enter when the closure starts."];
        if (c.End is null) errors["endUtc"] = ["Enter when the closure ends."];
        else if (c.Start is not null && c.End <= c.Start) errors["endUtc"] = ["The closure must end after it starts."];
        if (string.IsNullOrWhiteSpace(c.Reason)) errors["reason"] = ["Reason is required."];
        if (errors.Count > 0)
        {
            Fail(errors);
            return;
        }
        var start = CaseService.ToUtc(DateOnly.FromDateTime(c.Start!.Value), TimeOnly.FromDateTime(c.Start.Value), venue!.TimeZoneId);
        var end = CaseService.ToUtc(DateOnly.FromDateTime(c.End!.Value), TimeOnly.FromDateTime(c.End.Value), venue.TimeZoneId);
        BlackoutRow? added = null;
        var ok = await RunAsync(async me => added = await Admin.AddBlackoutAsync(me, new BlackoutInput(venue.Id, start, end, c.Reason)),
            $"Closure added at {venue.Name}.");
        if (!ok) return;
        _lastClosure = added;
        _closure = new ClosureForm { VenueId = venue.Id };
        await RefreshAsync(await GetActorAsync());
    }

    private async Task ToggleClosureAsync(BlackoutRow b, uint version, bool active)
    {
        _conflictRows = null;
        var ok = await RunAsync(me => Admin.SetBlackoutActiveAsync(me, b.Id, version, active),
            active ? $"Closure at {b.VenueName} reinstated." : $"Closure at {b.VenueName} lifted; the venue can be booked in that window again.");
        if (ok) await RefreshAsync(await GetActorAsync());
        else if (Problem?.StatusCode == 409)
        {
            await ConflictAsync(() =>
            {
                var saved = _blackouts.First(x => x.Id == b.Id);
                return Task.FromResult<IReadOnlyList<ConflictPanel.Row>>(
                [
                    new("Status", saved.IsActive ? "Closed" : "Lifted", active ? "Closed" : "Lifted"),
                    new("Reason", saved.Reason, b.Reason),
                ]);
            }, reload: () => Task.CompletedTask, reapply: () => ToggleClosureAsync(b, _blackouts.First(x => x.Id == b.Id).Version, active));
        }
    }

