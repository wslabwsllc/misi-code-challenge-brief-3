@page "/error"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@using System.Diagnostics

<PageTitle>Something went wrong · Memorial Event Operations</PageTitle>
<div class="landing">
    <div class="card card--narrow" data-testid="error">
        <h1 tabindex="-1">Something went wrong</h1>
        <p>The request could not be completed. Nothing was half-saved: changes are all-or-nothing.</p>
        <p>Quote this reference if you report the problem: <code>@RequestId</code></p>
        <p><a class="btn btn--primary" href="/">Go to the home page</a></p>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId => HttpContext?.TraceIdentifier ?? Activity.Current?.Id;
}
