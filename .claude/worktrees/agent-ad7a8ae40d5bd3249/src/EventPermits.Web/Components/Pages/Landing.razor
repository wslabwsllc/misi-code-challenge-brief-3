@page "/"
@layout PublicLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Memorial Event Operations · Permit case management</PageTitle>

<section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title" tabindex="-1">Memorial events, from application to closure</h1>
    <p>
        Memorial Event Operations is an internal case-management system for cemetery staff. It receives event applications,
        checks eligibility and venue availability, reserves spaces and resources, routes cases for approval, issues verifiable
        permits, runs the day of the event, records incidents and reports on all of it.
    </p>
    <div class="row">
        <AuthorizeView>
            <Authorized>
                <a class="btn btn--primary" href="/dashboard" data-testid="landing-dashboard">Go to your dashboard</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn--primary" href="/account/login" data-testid="landing-sign-in">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
        <a class="btn" href="#how-it-works">How it works</a>
    </div>
</section>

<div class="landing">
    <section aria-label="Practice notice">
        <p class="notice" role="note">
            <span aria-hidden="true">ⓘ</span>
            <span><strong>Fictional practice exercise, not a VA system.</strong> Every cemetery, person, application and document here is invented.
            Setup instructions and the demo accounts are in the repository README.</span>
        </p>
    </section>

    <section id="how-it-works" aria-labelledby="lifecycle-title">
        <h2 id="lifecycle-title">How a case moves</h2>
        <p>Each application follows one approved path. Every step is checked on the server and recorded in an append-only history.</p>
        <ol class="lifecycle" aria-label="Main path of a case">
            @foreach (var status in MainPath)
            {
                <li><span class="chip @Ui.StatusClass(status)">@Workflow.Display(status)</span></li>
            }
        </ol>
        <p class="muted">
            Side paths: a reviewer can send a case to <strong>Needs Information</strong> and back; a case can be <strong>Rejected</strong> at eligibility
            or at approval; an Operations Manager can <strong>Cancel</strong> a case before the event, which releases its venue and resources and
            invalidates its permit. Unlisted moves are refused.
        </p>
    </section>

    <section aria-labelledby="modules-title">
        <h2 id="modules-title">What it covers</h2>
        <div class="grid-3">
            @foreach (var (title, text) in Modules)
            {
                <article class="feature">
                    <h3>@title</h3>
                    <p>@text</p>
                </article>
            }
        </div>
    </section>

    <section aria-labelledby="roles-title">
        <h2 id="roles-title">Who uses it</h2>
        <div class="table-wrap card card--flush">
            <table class="table table--cards">
                <caption>Seven roles, each limited to its own work (a person may hold more than one)</caption>
                <thead><tr><th scope="col">Role</th><th scope="col">Does</th></tr></thead>
                <tbody>
                    @foreach (var (role, text) in RoleSummaries)
                    {
                        <tr><td data-label="Role"><strong>@role</strong></td><td data-label="Does">@text</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section aria-labelledby="integrations-title">
        <h2 id="integrations-title">Connected systems</h2>
        <p>Seven fictional external services run beside the application, so failures can be demonstrated safely:
            an applicant registry (API key), a regional events calendar (OAuth2), a notification gateway with signed delivery webhooks,
            private object storage with expiring links, a weather advisory service, a partner CSV feed and a geocoder.</p>
    </section>
</div>

@code {
    private static readonly CaseStatus[] MainPath =
    [
        CaseStatus.Draft, CaseStatus.Submitted, CaseStatus.Eligible, CaseStatus.TentativelyReserved, CaseStatus.PendingApproval,
        CaseStatus.Approved, CaseStatus.Permitted, CaseStatus.CheckedIn, CaseStatus.EventCompleted, CaseStatus.Closed,
    ];

    private static readonly (string, string)[] Modules =
    [
        ("Intake and register", "A four-step application wizard with autosave, a searchable case register with saved views and CSV export."),
        ("Eligibility review", "Checklists per event type, registry verification, information requests with due dates and responses."),
        ("Scheduling and resources", "Calendar views, venue availability with live collision checks, and chairs, tents, attendants and AV kits."),
        ("Approvals and permits", "Separation of duties at sign-off, versioned PDF permits with a QR token, reissue and revocation."),
        ("Event-day operations", "Daily rosters, readiness checklists, permit check-in and check-out, and an incident register."),
        ("Notifications and reporting", "Template-driven messages with delivery tracking and retry, dashboards, charts and exports."),
    ];

    private static readonly (string, string)[] RoleSummaries =
    [
        (Roles.Display(Roles.IntakeCoordinator), "Creates and submits applications, answers information requests, sees only their own cases."),
        (Roles.Display(Roles.EligibilityReviewer), "Reviews submitted applications, verifies applicants, requests information, passes or rejects."),
        (Roles.Display(Roles.SchedulingOfficer), "Reserves venues and resources without collisions and sends cases for approval."),
        (Roles.Display(Roles.OperationsManager), "Approves or rejects, issues and revokes permits, runs event days, resolves incidents and closes cases."),
        (Roles.Display(Roles.EventAttendant), "Works the assigned day roster, checks events in and out, logs incidents."),
        (Roles.Display(Roles.ComplianceAuditor), "Reads decisions, history and reports and exports audit data, without changing anything."),
        (Roles.Display(Roles.SystemAdmin), "Manages users, roles, venues, rules, templates and integrations, but cannot approve cases."),
    ];
}
