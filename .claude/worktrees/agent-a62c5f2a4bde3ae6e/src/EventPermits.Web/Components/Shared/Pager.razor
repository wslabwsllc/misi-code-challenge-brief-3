@* Server paging control: 20 rows per page (FR-03). Buttons are real buttons with accessible names. *@
<div class="pager">
    <span aria-live="polite">
        @if (Total == 0)
        {
            <text>No results</text>
        }
        else
        {
            <text>Showing @(((Page - 1) * PageSize) + 1)–@Math.Min(Page * PageSize, Total) of @Total.ToString("N0", Ui.Culture)</text>
        }
    </span>
    <div class="pager__buttons">
        <button type="button" class="btn btn--small" disabled="@(Page <= 1)" @onclick="() => Go(Page - 1)" aria-label="Previous page" data-testid="page-prev">‹ Previous</button>
        <span class="muted pager__label">Page @Page of @Pages</span>
        <button type="button" class="btn btn--small" disabled="@(Page >= Pages)" @onclick="() => Go(Page + 1)" aria-label="Next page" data-testid="page-next">Next ›</button>
    </div>
</div>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = Limits.PageSize;
    [Parameter] public int Total { get; set; }
    [Parameter] public EventCallback<int> OnPage { get; set; }

    private int Pages => Math.Max(1, (int)Math.Ceiling(Total / (double)PageSize));

    private Task Go(int page) => OnPage.InvokeAsync(Math.Clamp(page, 1, Pages));
}
