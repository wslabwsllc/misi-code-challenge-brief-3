<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- One image, six fictional external services. The service is chosen per process with
       the "service" argument or Mock:Service. See Program.cs. -->
  <PropertyGroup>
    <RootNamespace>EventPermits.Mocks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- AddKeyPerFile comes from the ASP.NET Core shared framework (an explicit reference fails with NU1510). -->
  </ItemGroup>
  <ItemGroup>
    <!-- Shared fictional reference data, published to data/reference/ next to the assembly. -->
    <Content Include="..\..\data\reference\*.json" LinkBase="data\reference" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The lock file is a restore input, not runtime content. -->
    <Content Update="packages.lock.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
